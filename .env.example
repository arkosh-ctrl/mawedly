# Copy to .env.local and fill in. Do NOT commit .env.local.

# Public base URL of the app (used to build the magic-link redirect).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# The "anon"/"publishable" key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Reserved for later week-1 steps (server-only, NOT used yet) ---
# The service_role / secret key — server-side only, never expose to the client.
# Used by the public booking API route (deposit insert) in a later step.
# SUPABASE_SERVICE_ROLE_KEY=
# Email (Resend)
# RESEND_API_KEY=
# TOKEN_ENCRYPTION_KEY=

# ── Lemon Squeezy (subscriptions) ──────────────────────────────
# See README-BILLING.md for setup. Use Test Mode keys during development.
LEMONSQUEEZY_API_KEY=your_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_PRO_VARIANT_ID=variant_id_pro
LEMONSQUEEZY_CENTER_VARIANT_ID=variant_id_center
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=variant_id_enterprise

# ── Lemon Squeezy (subscriptions) ──────────────────────────────
# See README-BILLING.md for setup. Use Test Mode keys during development.
LEMONSQUEEZY_API_KEY=your_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_PRO_VARIANT_ID=variant_id_pro
LEMONSQUEEZY_CENTER_VARIANT_ID=variant_id_center
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=variant_id_enterprise
